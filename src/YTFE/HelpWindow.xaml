<Window x:Class="YTFE.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico" Width="980" Height="700" MinWidth="720" MinHeight="480"
        Background="{DynamicResource AppBgBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Índice + búsqueda -->
        <DockPanel Grid.Column="0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBox x:Name="SearchBox" Padding="10,8" VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" />
                <TextBlock x:Name="SearchHint" Style="{StaticResource Muted}" Margin="12,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <Border Style="{StaticResource Card}" Padding="6">
                <Grid>
                    <ListBox x:Name="TopicList" BorderThickness="0" Background="Transparent"
                             SelectionChanged="TopicList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,3" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoResults" Style="{StaticResource Muted}" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8,16,8,0"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Grid>
            </Border>
        </DockPanel>

        <!-- Contenido del tema -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="28,22,28,22">
                <StackPanel x:Name="ContentHost" MaxWidth="700" HorizontalAlignment="Left" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
