<Window x:Class="YTFE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:YTFE.Localization"
        xmlns:inf="clr-namespace:YTFE.Infrastructure"
        Title="YTFE" Icon="Assets/app.ico" Height="780" Width="940" MinHeight="640" MinWidth="780"
        Background="{DynamicResource AppBgBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <inf:SiteLogoConverter x:Key="SiteLogo" />

        <!-- Texto de ayuda dentro del campo de URL mientras está vacío -->
        <Style x:Key="UrlHintStyle" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=UrlBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Estado vacío de la lista -->
        <Style x:Key="EmptyHintStyle" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Downloads.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Barra y estado según el estado de la descarga -->
        <Style x:Key="ItemProgress" TargetType="ProgressBar" BasedOn="{StaticResource DownloadProgress}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ItemStatus" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera: marca + ajustes -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Padding="14,5" Margin="0,0,8,0" Content="{loc:T HelpButton}" ToolTip="F1" Command="{Binding ShowHelpCommand}" />
                <Button Padding="12,5" Margin="0,0,8,0" Content="{loc:T SitesButton}" Command="{Binding ShowSitesCommand}" />
                <ComboBox Margin="0,0,8,0" MinWidth="96" ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Label" ToolTip="{loc:T Theme}" />
                <ComboBox MinWidth="96" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberPath="Label" ToolTip="{loc:T Language}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/logo.png" Width="46" Height="46" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="YTFE" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{loc:T Tagline}" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Enlace + acciones -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="UrlBox" Padding="12,10" FontSize="14" VerticalContentAlignment="Center"
                                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{loc:T UrlHint}" Style="{StaticResource UrlHintStyle}" />
                    </Grid>
                    <Button Grid.Column="1" Margin="10,0,0,0" Padding="18,10" Content="{loc:T Analyze}"
                            Command="{Binding AnalyzeCommand}" />
                    <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource AccentButton}"
                            Content="{loc:T Download}" IsDefault="True" Command="{Binding AddCommand}" />
                </Grid>
                <TextBlock Margin="2,8,0,0" Text="{Binding InfoText}" Style="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis" MinHeight="18" />
            </StackPanel>
        </Border>

        <!-- Opciones de descarga -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <Border Background="{DynamicResource ChipBrush}" CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="{loc:T Video}" GroupName="kind" IsChecked="{Binding IsVideo}" />
                        <RadioButton Style="{StaticResource Segment}" Content="{loc:T AudioOnly}" GroupName="kind" IsChecked="{Binding IsAudio}" />
                    </StackPanel>
                </Border>

                <!-- Vídeo -->
                <Grid Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{loc:T Resolution}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}"
                                  DisplayMemberPath="Label" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="{loc:T Container}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Containers}" SelectedItem="{Binding SelectedContainer}"
                                  DisplayMemberPath="Label" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:T VideoCodec}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Codecs}" SelectedItem="{Binding SelectedCodec}"
                                  DisplayMemberPath="Label" />
                    </StackPanel>
                </Grid>

                <!-- Audio -->
                <Grid Visibility="{Binding IsAudio, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{loc:T AudioFormat}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding AudioFormats}" SelectedItem="{Binding SelectedAudioFormat}"
                                  DisplayMemberPath="Label" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="{loc:T AudioQuality}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding AudioQualities}" SelectedItem="{Binding SelectedAudioQuality}"
                                  DisplayMemberPath="Label" IsEnabled="{Binding IsAudioQualityEnabled}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" VerticalAlignment="Bottom" Style="{StaticResource Muted}"
                               FontSize="12" TextWrapping="Wrap" Text="{loc:T LosslessNote}" />
                </Grid>

                <!-- Lista y recorte -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="{loc:T Playlist}" IsChecked="{Binding Playlist}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{loc:T CutLabel}" VerticalAlignment="Center" Style="{StaticResource Muted}"
                                   Margin="0,0,8,0" ToolTip="{loc:T CutHint}" />
                        <TextBlock Text="{loc:T CutFrom}" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="0,0,4,0" />
                        <TextBox Width="76" Padding="6,4" ToolTip="{loc:T CutHint}"
                                 Text="{Binding CutFrom, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{loc:T CutTo}" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="10,0,4,0" />
                        <TextBox Width="76" Padding="6,4" ToolTip="{loc:T CutHint}"
                                 Text="{Binding CutTo, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- Comunes + cookies -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="{loc:T EmbedMetadata}" IsChecked="{Binding EmbedMetadata}" Margin="0,0,20,0" />
                        <CheckBox Content="{loc:T EmbedThumbnail}" IsChecked="{Binding EmbedThumbnail}"
                                  IsEnabled="{Binding CanEmbedThumbnail}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T CookiesLabel}" VerticalAlignment="Center" Style="{StaticResource Muted}"
                                   Margin="0,0,6,0" ToolTip="{loc:T CookiesTip}" />
                        <ComboBox MinWidth="100" ItemsSource="{Binding CookieBrowsers}" SelectedItem="{Binding SelectedCookies}"
                                  DisplayMemberPath="Label" ToolTip="{loc:T CookiesTip}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Carpeta de salida -->
        <Grid Grid.Row="3" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:T SaveTo}" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="2,0,10,0" />
            <TextBox Grid.Column="1" Padding="8,6" VerticalContentAlignment="Center"
                     Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Margin="8,0,0,0" Padding="14,6" Content="{loc:T Browse}" Click="Browse_Click" />
        </Grid>

        <!-- Lista de descargas -->
        <DockPanel Grid.Row="4">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="{loc:T PauseAll}" Padding="12,4" Margin="0,0,6,0" Command="{Binding PauseAllCommand}" />
                <Button Content="{loc:T ResumeAll}" Padding="12,4" Margin="0,0,6,0" Command="{Binding ResumeAllCommand}" />
                <Button Content="{loc:T ClearFinished}" Padding="12,4" Command="{Binding ClearFinishedCommand}" />
            </StackPanel>

            <Grid>
                <TextBlock Text="{loc:T EmptyHint}" Style="{StaticResource EmptyHintStyle}" />

                <ListBox ItemsSource="{Binding Downloads}" HorizontalContentAlignment="Stretch"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource CardItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <!-- Clic derecho: las mismas acciones que el menú "⋯" -->
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:T Pause}" Command="{Binding PauseCommand}" />
                                        <MenuItem Header="{loc:T Resume}" Command="{Binding ResumeCommand}" />
                                        <MenuItem Header="{loc:T Cancel}" Command="{Binding CancelCommand}" />
                                        <MenuItem Header="{loc:T Retry}" Command="{Binding RetryCommand}" />
                                        <Separator />
                                        <MenuItem Header="{loc:T OpenFile}" Command="{Binding OpenFileCommand}" />
                                        <MenuItem Header="{loc:T ShowInFolder}" Command="{Binding ShowInFolderCommand}" />
                                        <MenuItem Header="{loc:T CopyLink}" Command="{Binding CopyLinkCommand}" />
                                        <MenuItem Header="{loc:T OpenInBrowser}" Command="{Binding OpenInBrowserCommand}" />
                                        <Separator />
                                        <MenuItem Header="{loc:T RemoveFromList}" Command="{Binding RemoveCommand}" />
                                        <MenuItem Header="{loc:T DeleteFiles}" Command="{Binding DeleteFilesCommand}" />
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource Chip}" Margin="0,0,10,0" Padding="3,3,10,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Margin="0,0,7,0" VerticalAlignment="Center"
                                                                    Content="{Binding Site, Mode=OneTime, Converter={StaticResource SiteLogo}, ConverterParameter=18}" />
                                                    <TextBlock Text="{Binding Site, Mode=OneTime}" FontSize="11" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource ChipTextBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Summary, Mode=OneWay}" Style="{StaticResource Muted}"
                                                   FontSize="11" Margin="0,4,0,0" />
                                        <ProgressBar Style="{StaticResource ItemProgress}" Margin="0,8,0,6"
                                                     Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource ItemStatus}">
                                            <Run Text="{Binding Status, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Detail, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Solo se ven los botones que tienen sentido en el estado actual -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Content="{loc:T Pause}" Padding="12,4" Margin="0,0,6,0" Command="{Binding PauseCommand}"
                                                Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="{loc:T Resume}" Padding="12,4" Margin="0,0,6,0" Command="{Binding ResumeCommand}"
                                                Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="{loc:T Retry}" Padding="12,4" Margin="0,0,6,0" Command="{Binding RetryCommand}"
                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="{loc:T OpenFile}" Padding="12,4" Margin="0,0,6,0" Command="{Binding OpenFileCommand}"
                                                Style="{StaticResource AccentButton}"
                                                Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="{loc:T Cancel}" Padding="12,4" Margin="0,0,6,0" Command="{Binding CancelCommand}"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                                        <Menu Background="Transparent" VerticalAlignment="Center">
                                            <MenuItem Header="⋯" FontWeight="Bold" Padding="8,3" ToolTip="{loc:T More}">
                                                <MenuItem Header="{loc:T ShowInFolder}" Command="{Binding ShowInFolderCommand}" />
                                                <MenuItem Header="{loc:T CopyLink}" Command="{Binding CopyLinkCommand}" />
                                                <MenuItem Header="{loc:T OpenInBrowser}" Command="{Binding OpenInBrowserCommand}" />
                                                <Separator />
                                                <MenuItem Header="{loc:T RemoveFromList}" Command="{Binding RemoveCommand}" />
                                                <MenuItem Header="{loc:T DeleteFiles}" Command="{Binding DeleteFilesCommand}" />
                                            </MenuItem>
                                        </Menu>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>

        <!-- Barra de estado -->
        <DockPanel Grid.Row="5" Margin="0,10,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Padding="12,4" Content="{loc:T UpdateTools}" Command="{Binding UpdateToolsCommand}" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding VersionsText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
